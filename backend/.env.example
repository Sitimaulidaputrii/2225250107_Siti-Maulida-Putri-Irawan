# Salin file ini menjadi .env lalu isi nilainya.

# WAJIB diganti untuk produksi (min. 32 karakter acak). Buat dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ganti-dengan-teks-acak-panjang

# SQLite cukup untuk uji coba 1–2 kelas. Untuk PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://user:sandi@host:5432/tandatepat
DATABASE_URL=sqlite:///./tandatepat.db

# Pisahkan dengan koma bila lebih dari satu (hanya perlu bila frontend di domain lain)
CORS_ORIGINS=http://localhost:5173

# Lokasi hasil build frontend (opsional)
# FRONTEND_DIST=../frontend/dist
